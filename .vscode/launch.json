{
    "version": "0.2.0",
    "configurations": [
        {
            // Debugs whatever target CMake Tools has selected. Pick the
            // `windows-clangcl` preset -- LLDB reads the CodeView/PDB output of
            // clang-cl + lld-link natively.
            "name": "Debug eve_bots (clang-cl + LLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "PATH": "${command:cmake.launchTargetDirectory};${env:PATH}"
            },
            "terminal": "integrated"
        }
    ]
}
